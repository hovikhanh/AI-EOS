# Cấu hình MINH HỌA cho demo cục bộ và smoke test CI (T-013). KHÔNG phải giá trị đã được duyệt: triển khai thật do người
# vận hành đặt (Implementation_Plan §7; D-57: giới hạn thử bắt buộc, không mặc định trong code). Không chứa secret.
# Dùng: cp demo.env .env  (file .env không commit)
AIEOS_ALLOWED_ORIGINS=https://localhost
AIEOS_SESSION_IDLE_MINUTES=30
AIEOS_SESSION_ABSOLUTE_HOURS=8
AIEOS_INVITE_TTL_HOURS=72
AIEOS_REAUTH_MINUTES=10
AIEOS_AUTH_RATE_LIMIT_ATTEMPTS=10
AIEOS_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AIEOS_AUTH_LOCKOUT_THRESHOLD=5
AIEOS_AUTH_LOCKOUT_MINUTES=15
AIEOS_PASSWORD_MIN_LENGTH=12
