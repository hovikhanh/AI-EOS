# Biến cấu hình và secret của AI-EOS (Implementation_Plan §7, T-004). CHỈ TÊN BIẾN — không ghi giá trị vào file này.
# Sao chép thành file môi trường không commit (.env bị .gitignore chặn) rồi điền giá trị.
# Secret có thể đặt qua file (Docker secrets): đặt <TÊN>_FILE=<đường dẫn file> thay cho <TÊN>; không đặt cả hai.
# Thiếu biến bắt buộc → tiến trình dừng, thông báo chỉ nêu tên biến (backend/src/aieos/platform/config.py).

# Secret — api, worker, CLI quản trị bootstrap-admin/recover-admin (role aieos_app)
AIEOS_DATABASE_URL=
# Secret — lệnh migration (role aieos_owner)
AIEOS_DATABASE_OWNER_URL=
# Secret — api
AIEOS_CSRF_KEY=
# 32 byte ngẫu nhiên, mã hóa base64 (vd. `openssl rand -base64 32`)
AIEOS_TOTP_ENCRYPTION_KEY=

# Cấu hình — api, worker
AIEOS_STORAGE_PATH=
# Cấu hình — api
AIEOS_ALLOWED_ORIGINS=
AIEOS_SESSION_IDLE_MINUTES=
AIEOS_SESSION_ABSOLUTE_HOURS=
AIEOS_INVITE_TTL_HOURS=
AIEOS_REAUTH_MINUTES=
# Giới hạn thử đăng nhập/MFA/lời mời/reauth và khóa tạm (D-57; bắt buộc, không mặc định)
AIEOS_AUTH_RATE_LIMIT_ATTEMPTS=
AIEOS_AUTH_RATE_LIMIT_WINDOW_SECONDS=
AIEOS_AUTH_LOCKOUT_THRESHOLD=
AIEOS_AUTH_LOCKOUT_MINUTES=
# Độ dài mật khẩu tối thiểu (D-58; bắt buộc, không mặc định) — api, CLI quản trị
AIEOS_PASSWORD_MIN_LENGTH=
# Cấu hình — worker
AIEOS_SCANNER_HOST=

# Tùy chọn — api, worker (provider AI, T-204; không có provider hệ thống vẫn chạy, SRS-NFR-07)
AIEOS_LLM_PROVIDERS=
AIEOS_OCR_PROVIDERS=
AIEOS_AI_BUDGET_LIMIT=
# JSON mảng provider (chính → dự phòng): name, adapter, local, classifications, timeout_seconds, max_retries,
# backoff_seconds, api_key, đơn giá (Implementation_Plan §40). Trần: Q-54.
# Secret theo provider: AIEOS_LLM_API_KEY_<NAME> (tên provider lấy từ AIEOS_LLM_PROVIDERS; T-204)

# Tùy chọn — công cụ backup (T-605)
AIEOS_BACKUP_TARGET=
